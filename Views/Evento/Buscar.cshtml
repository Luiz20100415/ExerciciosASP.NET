@using ExerciciosASP.NET.ViewModels

@model BuscaEventoViewModel
@{
    ViewData["Title"] = "Buscar evento";
}

<h1>Buscar evento</h1>
<form asp-action="Buscar" method="post">
    <input asp-for="NomeBusca" placeholder="Nome do evento..."/>
    <button type="submit">Buscar</button>
</form>

@if(Model.Resultados.Any())
{
    <table>
    <tr>
        <th>Nome</th>
        <th>Descricao</th>
        <th>Local</th>
        <th>DataEvento</th>
        <th>QuantidadesVagas</th>
        <th>ValorIngresso</th>
    </tr>
    @foreach(Evento a in Model.Resultados)
    {
        <tr>
            <td>@a.Nome</td>
            <td>@a.Descricao</td>
            <td>@a.Local</td>
            <td>@a.DataEvento</td>
            <td>@a.QuantidadesVagas</td>
            <td>@a.ValorIngresso</td>
            <td>
        </tr>
    }
</table>
}